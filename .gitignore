# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lockfile excluded — Cloudflare Pages has its own resolver.
# Local dev: `npm install` (macOS arm64 / linux x64) — npm picks binaries
# from package.json's platform-specific optionalDependencies on each install.
# Avoids EBADPLATFORM errors from stale macOS-built lockfiles on linux CI.
package-lock.json

# Build outputs
build/
dist/
.svelte-kit/
.vercel/

# Logs & temporary files
*.log
check.log
*.tsbuildinfo

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
.env.*.local

# Inlang cache (auto-generated)
project.inlang/cache/

# Hermes plans (kept in ~/.hermes/plans/, not in repo)
.hermes/