{
  "name": "marginlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.0.20",
    "@fontsource/dm-serif-display": "^5.0.20",
    "@sveltejs/adapter-static": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.1.4",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@inlang/paraglide-sveltekit": "^0.16.1"
  }
}
